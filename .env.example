# ==============================================================================
# CEO OS — ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Free Tier Configuration (Optional for local offline use, required for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-ONLY — never expose to the browser)
# Required for background/offline sync: lets the cron job and API routes
# read & write tasks and Google tokens on your behalf, bypassing RLS.
# Find it in Supabase Dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CEO OS is single-user. Set ONE of the two below so server routes know
# which app user row to read/write:
# - SUPABASE_USER_ID: paste an existing auth.users UUID (Dashboard > Authentication > Users)
# - SUPABASE_USER_EMAIL: an email to auto-create that user on first run
SUPABASE_USER_ID=
SUPABASE_USER_EMAIL=

# Secret used to authenticate Vercel Cron requests to /api/cron/google-sync.
# Set this exact value as a Vercel env var — Vercel automatically sends it
# as "Authorization: Bearer <value>" on cron requests when the var is named
# CRON_SECRET. Generate any random string, e.g.: openssl rand -hex 32
CRON_SECRET=

# Optional AI API Key (Bring Your Own Key - Optional & Isolated)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Google OAuth 2.0 Credentials (Required for Google Tasks & Google Calendar Sync)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
